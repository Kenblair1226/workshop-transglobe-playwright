<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.4</version>
    <relativePath/>
  </parent>

  <groupId>com.transglobe</groupId>
  <artifactId>app-modernization-demo</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>app-modernization-demo</name>
  <description>
    Insurance Policy REST API used as a Java/Spring Boot App Modernization workshop demo.
    Contains an intentionally "legacy-but-building" baseline and a bounded, in-place
    modernization checkpoint. No database or cloud dependency; everything runs in-memory.
  </description>

  <properties>
    <!-- Java 17 toolchain, built and run with Maven 3.6.3 -->
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Force UTF-8 everywhere: compilation, resource filtering, reporting and test output -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <argLine>-Dfile.encoding=UTF-8</argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Included from day one so the baseline->modernized checkpoint never needs a pom change.
      The baseline intentionally does NOT use Bean Validation annotations (it validates
      manually instead); the modernized checkpoint activates @Valid / Jakarta constraints
      using this same dependency.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Optional annotation processor for @ConfigurationProperties metadata/IDE support.
      Present in the baseline pom but unused until the modernized checkpoint introduces
      PricingProperties, so no dependency changes are required between checkpoints.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
